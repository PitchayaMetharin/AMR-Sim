<?xml version="1.0"?>
<package format="3">
  <name>amr_mpc_controller</name>
  <version>0.1.0</version>
  <description>Simulation-only Nav2 regulated pure pursuit controller configuration for the AMR.</description>
  <maintainer email="amr@example.invalid">AMR project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <depend>nav2_regulated_pure_pursuit_controller</depend>
  <depend>nav2_core</depend>
  <depend>pluginlib</depend>
  <depend>tf2</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
