# Navigate to a named station. Version one accepts the home station only.
string station_id
---
uint8 SUCCESS=0
uint8 NAVIGATION_FAILED=1
uint8 CANCELED=2
uint8 INTERLOCK_FAILED=3
uint8 INVALID_REQUEST=4
uint8 DEPENDENCY_UNAVAILABLE=5

uint8 outcome
string message
---
uint8 phase
string current_station_id
