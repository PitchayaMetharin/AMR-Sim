# Execute one complete station-to-dispatch manipulation cycle.
string pickup_station_id
string destination_station_id
---
uint8 SUCCESS=0
uint8 INVALID_REQUEST=1
uint8 DEPENDENCY_UNAVAILABLE=2
uint8 PREPARATION_FAILED=3
