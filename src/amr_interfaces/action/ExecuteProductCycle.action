uint8 CANCELED=5
uint8 INTERLOCK_FAILED=6
uint8 RETAINED_PRODUCT_FAULT=7

bool delivered
uint8 outcome
string product_id
string message
---
uint8 PREPARING=1
uint8 EXECUTING=2
