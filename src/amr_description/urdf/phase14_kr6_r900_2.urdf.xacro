<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="phase14_kr6_r900_2">
  <xacro:include filename="$(find kuka_agilus_support)/urdf/kr6_r900_2_macro.xacro"/>
  <xacro:arg name="controller_config" default=""/>

  <xacro:macro name="arm_position_interface" params="joint initial_position">
    <joint name="${joint}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <link name="world"/>
  <xacro:kuka_kr6_r900_2_robot prefix="arm_" package_name="kuka_agilus_support"/>
  <joint name="world_to_arm_base" type="fixed">
    <parent link="world"/>
    <child link="arm_base_link"/>
  </joint>

  <ros2_control name="Phase14KukaSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:arm_position_interface joint="arm_joint_1" initial_position="0.0"/>
    <xacro:arm_position_interface joint="arm_joint_2" initial_position="-1.5708"/>
    <xacro:arm_position_interface joint="arm_joint_3" initial_position="1.5708"/>
    <xacro:arm_position_interface joint="arm_joint_4" initial_position="0.0"/>
    <xacro:arm_position_interface joint="arm_joint_5" initial_position="0.0"/>
    <xacro:arm_position_interface joint="arm_joint_6" initial_position="0.0"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controller_config)</parameters>
    </plugin>
  </gazebo>
</robot>
