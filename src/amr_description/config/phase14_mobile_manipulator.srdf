<?xml version="1.0"?>
<robot name="phase14_mobile_manipulator">
  <group name="manipulator">
    <chain base_link="arm_base_link" tip_link="gripper_tcp"/>
  </group>
  <group name="gripper">
    <joint name="gripper_finger_joint"/>
    <joint name="gripper_right_finger_joint"/>
  </group>
  <end_effector name="product_gripper" parent_link="arm_tool0" group="gripper" parent_group="manipulator"/>
  <group_state name="stowed" group="manipulator">
    <joint name="arm_joint_1" value="0.0"/>
    <joint name="arm_joint_2" value="-1.5708"/>
    <joint name="arm_joint_3" value="1.5708"/>
    <joint name="arm_joint_4" value="0.0"/>
    <joint name="arm_joint_5" value="0.0"/>
    <joint name="arm_joint_6" value="0.0"/>
  </group_state>

  <!-- Existing base model contacts at their kinematic connections. -->
  <disable_collisions link1="base_link" link2="left_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_left_caster_mount" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_left_caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_right_caster_mount" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_right_caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_left_caster_mount" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_left_caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_right_caster_mount" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_right_caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="front_left_caster_mount" link2="front_left_caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="front_right_caster_mount" link2="front_right_caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="rear_left_caster_mount" link2="rear_left_caster_wheel" reason="Adjacent"/>
  <disable_collisions link1="rear_right_caster_mount" link2="rear_right_caster_wheel" reason="Adjacent"/>

  <!-- Upstream KUKA and project gripper adjacent-link contacts. -->
  <disable_collisions link1="base_link" link2="arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link" link2="arm_link_1" reason="Adjacent"/>
  <disable_collisions link1="arm_link_1" link2="arm_link_2" reason="Adjacent"/>
  <disable_collisions link1="arm_link_2" link2="arm_link_3" reason="Adjacent"/>
  <disable_collisions link1="arm_link_3" link2="arm_link_4" reason="Adjacent"/>
  <disable_collisions link1="arm_link_4" link2="arm_link_5" reason="Adjacent"/>
  <disable_collisions link1="arm_link_5" link2="arm_link_6" reason="Adjacent"/>
  <disable_collisions link1="arm_link_6" link2="gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_link_6" link2="gripper_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="arm_link_6" link2="gripper_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_right_finger_link" reason="Adjacent"/>
</robot>
